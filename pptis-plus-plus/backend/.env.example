FLASK_ENV=development
FLASK_APP=app.py
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-jwt
JWT_ACCESS_TOKEN_EXPIRES=3600
CORS_ORIGINS=http://localhost:3000

# sqlite (default) or postgres
# DATABASE_URL=postgresql://pptis:pptis@localhost:5432/pptis
USE_POSTGRES=false
SQLITE_PATH=pptis.db
POSTGRES_USER=pptis
POSTGRES_PASSWORD=pptis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pptis

WHISPER_MODEL=base.en
WHISPER_TIMEOUT_SECONDS=120
SLANG_MODEL_NAME=xlm-roberta-base
SLANG_THRESHOLD=0.7
SLANG_CLASSIFIER_PATH=
SLANG_CSV_PATH=../database/slang_dictionary.csv

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3

LOGISTIC_B=0.0
LOGISTIC_W_E=1.0
LOGISTIC_W_P=1.0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pptis.local
SMTP_TLS=true
