FLASK_ENV=development
FLASK_APP=app.py
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000

# PostgreSQL is required. The application will not start on SQLite.
DATABASE_URL=postgresql://pptis:pptis@localhost:5432/pptis
POSTGRES_USER=pptis
POSTGRES_PASSWORD=pptis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pptis

# Mandatory models. Do not point these at a smaller checkpoint.
SLANG_MODEL_NAME=xlm-roberta-base
# The trained head stores 0.58. A different value is rejected.
# SLANG_THRESHOLD=0.58
SLANG_CLASSIFIER_PATH=
SLANG_CSV_PATH=../database/slang_dictionary.csv

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

LOGISTIC_B=0.0
LOGISTIC_W_E=1.0
LOGISTIC_W_P=1.0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pptis.local
SMTP_TLS=true
